# Example environment configuration for the portfolio chatbot.
# Copy this file to .env (local development) or set these as Vercel
# Environment Variables in the project settings dashboard.
#
# NEVER commit your real API key to the repository. The .env file is
# gitignored and should remain local only.

# OpenAI API key — server-side only, never exposed to the browser.
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI model to use for chat completions.
OPENAI_MODEL=gpt-4o-mini
